class Solution {
    public int findNumbers(int[] nums) {
         if(nums.length==0){
            return -1;
         }
        int count = 0;

        for (int i = 0; i < nums.length; i++) {
            if (String.valueOf(nums[i]).length() % 2 == 0) {
                count++;
            }
        }

        return count;
    }
}
        
